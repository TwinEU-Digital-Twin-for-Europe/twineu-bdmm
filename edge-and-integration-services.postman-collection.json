{
  "info": {
    "name": "TwinEU Edge & Integration Services",
    "description": "Exhaustive collection for interacting with the TwinEU BDMM Data Collection API and the AIMIC Publishing API at the edge.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Marketplace Login (Auto-Set JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.access_token);",
                  "    console.log(\"JWT Token successfully updated in collection variables!\");",
                  "} else {",
                  "    console.error(\"Login failed. Check credentials.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@twineu.eu\",\n  \"password\": \"your-secure-password\"\n}"
            },
            "url": {
              "raw": "{{base_url_marketplace}}/api/auth/login",
              "host": ["{{base_url_marketplace}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. BDMM (Data Collection API)",
      "item": [
        {
          "name": "Ingest Batch Data (File Upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url_bdmm}}/ingest/batch",
              "host": ["{{base_url_bdmm}}"],
              "path": ["ingest", "batch"]
            }
          }
        },
        {
          "name": "Ingest Streaming Data (JSON Payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensor_id\": \"wind_turbine_01\",\n  \"timestamp\": \"2026-08-12T14:30:00Z\",\n  \"power_output_kw\": 1250.5\n}"
            },
            "url": {
              "raw": "{{base_url_bdmm}}/ingest",
              "host": ["{{base_url_bdmm}}"],
              "path": ["ingest"]
            }
          }
        },
        {
          "name": "Trigger Data Retention (Specific Source)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_bdmm}}/maintenance/cleanup?source=wind_turbine_01&days_old=30",
              "host": ["{{base_url_bdmm}}"],
              "path": ["maintenance", "cleanup"],
              "query": [
                {
                  "key": "source",
                  "value": "wind_turbine_01",
                  "description": "The specific source label to clean up."
                },
                {
                  "key": "days_old",
                  "value": "30",
                  "description": "Delete files older than this many days."
                }
              ]
            },
            "description": "Deletes obsolete data for a specific source from both raw and batch containers."
          }
        },
        {
          "name": "Trigger Data Retention (Global Wipe)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_bdmm}}/maintenance/cleanup-global?days_old=30",
              "host": ["{{base_url_bdmm}}"],
              "path": ["maintenance", "cleanup-global"],
              "query": [
                {
                  "key": "days_old",
                  "value": "30",
                  "description": "Delete files older than this many days across ALL sources."
                }
              ]
            },
            "description": "Recursively deletes obsolete data across all sources in both raw and batch containers."
          }
        }
      ]
    },
